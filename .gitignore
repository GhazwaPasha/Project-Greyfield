# Operation Greyfield - Unreal Engine 5.8 project .gitignore

# Visual Studio / Rider / VS Code generated project files (regenerated from .uproject)
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Build/derived/cache folders (regenerated by the engine)
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/

# Per-module intermediate/generated folders anywhere in Source/ or Plugins/
**/Intermediate/
**/Binaries/

# Automation tool solution (regenerated alongside the main .sln)
Automation_ProjectGreyfield.sln
Automation_ProjectGreyfield.slnx

# Plugins built from source keep their own generated folders too
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Crash/log/profiling output that sometimes lands at project root
*.log
*.pdb

# OS/editor cruft
.DS_Store
Thumbs.db

# Local-only override configs (per-machine editor settings, not shared)
Saved/Config/
